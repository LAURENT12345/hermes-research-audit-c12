# C0 — Document Pipeline environment configuration
#
# Everything else is a code constant in docpipe/config.py (chunk sizes,
# upload limit, search limits, db filename). There are no secrets in C0.
#
# Copy to your Hermes .env only if you need to change the defaults.

# Bind address for `hermes docpipe serve` / `python -m docpipe.serve`.
# Keep 127.0.0.1 unless you are behind an authenticated reverse proxy
# (C0 implements no authentication).
DOCPIPE_HOST=127.0.0.1

# Port for the C0 API server.
DOCPIPE_PORT=8731
